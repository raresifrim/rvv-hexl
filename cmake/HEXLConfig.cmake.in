# HEXLConfig.cmake — installed by rvv-hexl's `make install`.
#
# Makes the port discoverable exactly like an upstream Intel HEXL install:
#   find_package(HEXL 1.2.6 HINTS <prefix>)   ->  imported target HEXL::hexl
# This is what openfhe-hexl's third-party/intel-hexl/intel-hexl.cmake does when
# configured with -DINTEL_HEXL_PREBUILT=ON -DINTEL_HEXL_HINT_DIR=<prefix>, and
# what SEAL does with -DSEAL_USE_INTEL_HEXL=ON. Hand-written (the library is
# built with make, not CMake), so it only declares the one imported target.

get_filename_component(_HEXL_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT TARGET HEXL::hexl)
  add_library(HEXL::hexl @HEXL_LIB_TYPE@ IMPORTED GLOBAL)
  set_target_properties(HEXL::hexl PROPERTIES
    IMPORTED_LOCATION "${_HEXL_PREFIX}/lib/@HEXL_LIB_NAME@"
    INTERFACE_INCLUDE_DIRECTORIES "${_HEXL_PREFIX}/include")
endif()

set(HEXL_FOUND TRUE)
set(HEXL_VERSION @HEXL_VERSION@)
set(HEXL_RVV_PORT TRUE)
message(STATUS "HEXL: using rvv-hexl (API @HEXL_VERSION@) at ${_HEXL_PREFIX}")
unset(_HEXL_PREFIX)
